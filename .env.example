# Copy to .env for local development. Never commit real values.

# Storage (SQLite file; invoices PDFs are stored next to it in <dir>/invoices)
DATABASE_PATH=./data/payroll.sqlite

# Chain (Ethereum Sepolia only). Public RPC; never a private node URL.
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com

# Wallet (optional; WalletConnect is skipped when empty)
VITE_WALLETCONNECT_PROJECT_ID=

# LLM provider: bedrock | anthropic | mock
LLM_PROVIDER=mock
AWS_REGION=eu-central-1
BEDROCK_MODEL_EXTRACT=eu.anthropic.claude-haiku-4-5-20251001-v1:0
BEDROCK_MODEL_REASON=eu.anthropic.claude-sonnet-4-5-20250929-v1:0
ANTHROPIC_API_KEY=

# Data providers (all optional; checks degrade to skip/mock)
TATUM_API_KEY=
APIFY_TOKEN=
MOSTLYRIGHT_API_KEY=

# Thyme Flow: the only payment rail. The app holds no private key; it performs the Thyme onboarding for the
# user's own Safe over the HTTP API (Roles profile scoped to EURC.transfer, executable, webhook) and stores
# the resulting ids in the settings table. THYME_API_KEY is a management or project key of the project that
# holds the uploaded pay-invoice function (THYME_FUNCTION_ID from `thyme upload`).
THYME_API_URL=https://dev.api-http.thyme.sh
THYME_API_KEY=
THYME_PROJECT_ID=
THYME_FUNCTION_ID=
# Shared secret the Flow task presents as X-Thyme-Token on /api/thyme/pending and /api/webhooks/thyme.
# Generate one random value; the onboarding passes it to the executable as a task arg.
THYME_PULL_TOKEN=
# Only for keys that are not bound to a workspace (sent as X-Workspace-Id)
THYME_WORKSPACE_ID=
# Optional, only for a pre-provisioned executable (the onboarding stores its own ids in settings)
THYME_EXECUTABLE_ID=
THYME_PAY_WEBHOOK_URL=

# Payment execution: thyme (default; falls back to labelled simulated payouts until a Safe is enabled) | simulated
PAYMENT_EXECUTOR=thyme
AUTO_PAY_THRESHOLD=100

# App
APP_URL=http://localhost:3000
PORT=3000
