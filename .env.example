# Copy to .env for local development. Never commit real values.

# Storage (SQLite file; invoices PDFs are stored next to it in <dir>/invoices)
DATABASE_PATH=./data/payroll.sqlite

# Chain (Ethereum Sepolia only). Public RPC; never a private node URL.
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com

# Wallet (optional; WalletConnect is skipped when empty)
VITE_WALLETCONNECT_PROJECT_ID=

# LLM provider: bedrock | anthropic | mock
LLM_PROVIDER=mock
AWS_REGION=eu-central-1
BEDROCK_MODEL_EXTRACT=eu.anthropic.claude-haiku-4-5-20251001-v1:0
BEDROCK_MODEL_REASON=eu.anthropic.claude-sonnet-4-5-20250929-v1:0
ANTHROPIC_API_KEY=

# Data providers (all optional; checks degrade to skip/mock)
TATUM_API_KEY=
APIFY_TOKEN=
MOSTLYRIGHT_API_KEY=

# Thyme Flow (payment rail)
THYME_API_URL=
THYME_API_KEY=
THYME_PAY_WEBHOOK_URL=
THYME_PULL_TOKEN=

# Payment execution
PAYMENT_EXECUTOR=direct
AGENT_PRIVATE_KEY=
AUTO_PAY_THRESHOLD=100

# App
APP_URL=http://localhost:3000
PORT=3000
